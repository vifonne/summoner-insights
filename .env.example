# Riot Games API Configuration
# Get your API key from: https://developer.riotgames.com/

# Your Riot API key
RIOT_API_KEY=your_riot_api_key_here

# Your in-game username (without the #tag)
RIOT_USERNAME=YourGameName

# Your Riot ID tag, the part after the # (e.g. Player#EUW -> EUW)
RIOT_TAGLINE=NA1

# Optional: the server your account plays on. Defaults to RIOT_TAGLINE.
# Set it when your tag is not a server code (e.g. tag EUW -> platform EUW1)
RIOT_PLATFORM=NA1

# Supported platforms:
# Americas: NA1, BR1, LA1, LA2
# Europe: EUW1, EUN1, TR1, RU  
# Asia: KR, JP1